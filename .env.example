# --- Serveur ---
PORT=5000
NODE_ENV=development

# --- Base de données ---
MONGO_URI=mongodb://127.0.0.1:27017/gestion_notes_bulletins

# --- Authentification ---
# Générez une vraie clé : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=remplacez_par_une_longue_cle_aleatoire
JWT_EXPIRES_IN=7d

# Compte administrateur, utilisé UNIQUEMENT par `npm run admin` (création du premier admin).
# Si ADMIN_MOT_DE_PASSE est vide, un mot de passe est généré et affiché une seule fois.
ADMIN_EMAIL=
ADMIN_MOT_DE_PASSE=

# --- Optionnel ---
# Origines autorisées pour CORS, séparées par des virgules (en production, vide = CORS désactivé)
CORS_ORIGIN=
# Nombre max de tentatives de connexion ratées par IP et par 15 min (défaut : 10)
RATE_LIMIT_MAX=10
# À renseigner (ex : 1) si l'app est derrière un proxy/reverse-proxy (Render, Nginx...)
TRUST_PROXY=
